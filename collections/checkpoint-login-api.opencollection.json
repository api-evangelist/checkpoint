{
  "opencollection": "1.0.0",
  "info": {
    "name": "Check Point CloudGuard Access Rules Login API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Login to Gaia",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dome9.com/v2/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Login to Gaia"
        },
        {
          "info": {
            "name": "Logout the current session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dome9.com/v2/logout"
          },
          "docs": "Logout the current session"
        }
      ]
    }
  ],
  "bundled": true
}